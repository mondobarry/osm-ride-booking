#: includes/class-orb-settings.php:199
#: includes/class-orb-woocommerce.php:40
msgid "Ride booking"
msgstr "Réservation de courses"

#: includes/class-orb-settings.php:39
msgid "OpenRouteService API key"
msgstr "Clé API OpenRouteService"

#: includes/class-orb-settings.php:40
msgid "Free key (2,000 routes a day) at openrouteservice.org. Stored in your database only."
msgstr "Clé gratuite (2 000 itinéraires par jour) sur openrouteservice.org. Stockée uniquement dans votre base de données."

#: includes/class-orb-settings.php:41
msgid "Countries for address search"
msgstr "Pays pour la recherche d’adresse"

#: includes/class-orb-settings.php:42
msgid "Two-letter codes separated by commas, e.g. fr,be,ch. Empty = your store country."
msgstr "Codes à deux lettres séparés par des virgules, ex. fr,be,ch. Vide = le pays de votre boutique."

#: includes/class-orb-settings.php:44
msgid "Price per km"
msgstr "Prix au km"

#: includes/class-orb-settings.php:45
msgid "Price per km, long trips"
msgstr "Prix au km, longues distances"

#: includes/class-orb-settings.php:46
msgid "Applies to the whole trip when it is longer than the threshold below."
msgstr "S’applique à toute la course quand elle dépasse le seuil ci-dessous."

#: includes/class-orb-settings.php:47
msgid "Long trip threshold (km)"
msgstr "Seuil longue distance (km)"

#: includes/class-orb-settings.php:48
msgid "0 = always use the standard price."
msgstr "0 = toujours le prix standard."

#: includes/class-orb-settings.php:49
msgid "Minimum fare"
msgstr "Prix minimum"

#: includes/class-orb-settings.php:50
msgid "Prices follow your WooCommerce tax settings (entered with or without tax)."
msgstr "Les prix suivent vos réglages de taxes WooCommerce (saisis HT ou TTC)."

#: includes/class-orb-settings.php:52
msgid "Minimum notice (minutes)"
msgstr "Délai minimum (minutes)"

#: includes/class-orb-settings.php:53
msgid "How long before pickup a ride can still be booked online."
msgstr "Délai avant la prise en charge en dessous duquel on ne peut plus réserver en ligne."

#: includes/class-orb-settings.php:54
msgid "Buffer around rides (minutes)"
msgstr "Marge autour des courses (minutes)"

#: includes/class-orb-settings.php:55
msgid "Time blocked before and after each paid ride."
msgstr "Temps bloqué avant et après chaque course payée."

#: includes/class-orb-settings.php:56
msgid "One ride at a time"
msgstr "Une course à la fois"

#: includes/class-orb-settings.php:57
msgid "Refuse a booking that overlaps a paid ride (single vehicle). Untick if you run several vehicles."
msgstr "Refuser une réservation qui chevauche une course payée (un seul véhicule). Décochez si vous avez plusieurs véhicules."

#: includes/class-orb-settings.php:58
msgid "Show estimated duration"
msgstr "Afficher la durée estimée"

#: includes/class-orb-settings.php:59
msgid "Untick if traffic makes travel times unreliable in your area."
msgstr "Décochez si la circulation rend les durées peu fiables dans votre secteur."

#: includes/class-orb-settings.php:61
msgid "Enable peak-hour surcharge"
msgstr "Activer la majoration heures de pointe"

#: includes/class-orb-settings.php:62
msgid "Surcharge (%)"
msgstr "Majoration (%)"

#: includes/class-orb-settings.php:63
msgid "Days"
msgstr "Jours"

#: includes/class-orb-settings.php:64
msgid "Pickup time slots"
msgstr "Créneaux de prise en charge"

#: includes/class-orb-settings.php:65
msgid "Format HH:MM-HH:MM, separated by commas."
msgstr "Format HH:MM-HH:MM, séparés par des virgules."

#: includes/class-orb-settings.php:66
msgid "No surcharge on French public holidays"
msgstr "Pas de majoration les jours fériés français"

#: includes/class-orb-settings.php:67
msgid "Zone (GeoJSON, optional)"
msgstr "Zone (GeoJSON, facultatif)"

#: includes/class-orb-settings.php:68
msgid "Paste a GeoJSON Polygon, MultiPolygon or FeatureCollection: the surcharge then applies only when pickup or drop-off is inside. Empty = everywhere."
msgstr "Collez un Polygon, MultiPolygon ou FeatureCollection GeoJSON : la majoration ne s’applique alors que si le départ ou l’arrivée est dans la zone. Vide = partout."

#: includes/class-orb-settings.php:70
#: includes/class-orb-settings.php:81
msgid "Legal notice"
msgstr "Mention légale"

#: includes/class-orb-settings.php:71
msgid "Shown on the booking form, cart, checkout, order pages and emails. Example for a French VTC operator: \"Service de voiture de transport avec chauffeur — réservation préalable (art. R3120-2 du Code des transports). Exploitant : [raison sociale], [adresse], SIREN [numéro].\""
msgstr "Affichée sur le formulaire, le panier, la validation de commande, les pages de commande et les e-mails. Exemple pour un exploitant VTC : \"Service de voiture de transport avec chauffeur — réservation préalable (art. R3120-2 du Code des transports). Exploitant : [raison sociale], [adresse], SIREN [numéro].\""

